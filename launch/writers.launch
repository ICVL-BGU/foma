<!-- Launch file for writer node instances.
     All per-node params live in config/foma_params.yaml under top-level keys
     matching each node name; loading the YAML globally populates each node's
     private namespace (~param) automatically. -->
<launch>
    <rosparam command="load" file="$(find foma)/config/foma_params.yaml" />

    <!-- CSV Writers -->
    <node name="csv_writer_foma_location" pkg="foma" type="csv_writer_node.py" output="screen"/>
    <node name="csv_writer_fish_location" pkg="foma" type="csv_writer_node.py" output="screen"/>
    <node name="csv_writer_foma_speed"    pkg="foma" type="csv_writer_node.py" output="screen"/>
    <node name="csv_writer_lidar"         pkg="foma" type="csv_writer_node.py" output="screen"/>

    <!-- Event Writer -->
    <node name="event_writer" pkg="foma" type="event_writer_node.py" output="screen"/>

    <!-- Room camera: record native H.264 directly from RTSP, bypassing ROS image topics. -->
    <node name="room_recorder"         pkg="foma" type="room_recorder_node.py" output="screen"/>

    <!-- Video Writers -->
    <node name="video_writer_foma"     pkg="foma" type="video_writer_node.py" output="screen"/>
    <node name="video_writer_room_map" pkg="foma" type="video_writer_node.py" output="screen"/>
</launch>
