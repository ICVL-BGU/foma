<launch>   
    <!-- Node 1 -->
    <node pkg="foma" type="lidar_node.py" name="lidar_node" output="screen"/>
    <!-- <launch-prefix="gdb args python3"/> add 2 minuses before args-->

    <!-- Node 2 -->
    <node pkg="foma" type="motor_control_node.py" name="motor_control_node" output="screen"/>

    <!-- Node 3 -->
    <node pkg="foma" type="video_camera_node.py" name="video_camera_node" output="screen"/>

    <!-- Node 4 -->
    <node pkg="foma" type="feeder_node.py" name="feeder_node" output="screen"/>

    <!-- Go Home -->
    <node pkg="foma" type="goHomeNode.py" name="go_home_node" output="screen">
        <param name="goal_x" value="0.5"/>
        <param name="goal_y" value="0.5"/>
        <param name="arrival_tol" value="0.03"/>
    </node>
</launch>